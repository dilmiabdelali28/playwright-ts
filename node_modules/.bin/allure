#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/frx29692/Documents/Foncia/millenium/node_modules/.pnpm/allure-commandline@2.38.1/node_modules/allure-commandline/node_modules:/Users/frx29692/Documents/Foncia/millenium/node_modules/.pnpm/allure-commandline@2.38.1/node_modules:/Users/frx29692/Documents/Foncia/millenium/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/frx29692/Documents/Foncia/millenium/node_modules/.pnpm/allure-commandline@2.38.1/node_modules/allure-commandline/node_modules:/Users/frx29692/Documents/Foncia/millenium/node_modules/.pnpm/allure-commandline@2.38.1/node_modules:/Users/frx29692/Documents/Foncia/millenium/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../allure-commandline/bin/allure" "$@"
else
  exec node  "$basedir/../allure-commandline/bin/allure" "$@"
fi
